{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Authentication": "Information",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Secret": "change-this-to-a-very-long-random-secret-key-min-32-chars",
    "Issuer": "JobProcessingSystem",
    "Audience": "JobProcessingClients",
    "AccessTokenExpiryMinutes": "15",
    "RefreshTokenExpiryDays": "7"
  },
  "AdminUser": {
    "Username": "admin",
    "Password": "Admin@123456"
  },
  "AllowedHosts": "*"
}